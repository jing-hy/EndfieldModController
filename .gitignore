# ============================================================
# 注意：.gitignore 不支持行内注释！
# 「模式  # 注释」会被当成一整个模式，导致该模式失效。
# 所以注释一律单独成行。
# ============================================================

# ── 用户数据 / 个人内容 —— 绝不提交 ──────────────────────────
library/
runtime/
config.json
config.json.*
*.mc.bak
*.mc.tmp
*.ini.bak*
*.bak-before-*
_tmp/
dist/
build/
*.spec

# ── 第三方二进制（体积大，请从各原仓库获取）──────────────────
reshade-shaders/
*.addon64
*.addon32
*.dll
*.exe

# ── 例外：随包分发的 DLSS 运行库资产（**必须进仓库**）──────────
# nvngx_dlss*.dll 一百多 MB，超过 GitHub 单文件 100 MiB 上限，
# 所以压缩 + 分卷放在 assets/nvngx/，首次启动自动展开到 runtime\dlss5\，
# 用户不必自己去找运行库。重新打包：python scripts/pack_nvngx_assets.py
!assets/
!assets/nvngx/
!assets/nvngx/*.xz
!assets/nvngx/*.part*
!assets/nvngx/manifest.json

# ── 凭据 / 密钥 —— 绝不提交 ──────────────────────────────────
.env
.env.*
*.pem
*.key
*.der
*secret*
*token*
credentials.json

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ── 构建输出 ─────────────────────────────────────────────────
reshade_addon/build/
reshade_addon/cmake-build/
*.o
*.obj
*.zip

# ── 本机遗留物 ───────────────────────────────────────────────
.dsh-meow/
.vscode/
.idea/
Thumbs.db
desktop.ini

# 运行期备份文件（不要让它们进仓库）
*.bak-*
